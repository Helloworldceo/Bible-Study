{
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server.ts,db.ts,discordVerses.ts}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/discord/daily-post", "schedule": "0 8 * * *" },
    { "path": "/api/push/daily-reminder", "schedule": "0 20 * * *" }
  ]
}
