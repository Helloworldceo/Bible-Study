# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Required. A Neon Postgres connection string, used for user
# accounts, auth tokens, and multi-device sync data (see db.ts). Use the
# *pooled* connection string from your Neon project (Dashboard -> Connect,
# "Pooled connection") -- this app runs fine on a serverless/edge platform,
# which a direct (non-pooled) connection can't handle under concurrent load.
# Do NOT append `channel_binding=require`; some environments can't resolve
# it reliably. `sslmode=require` alone is sufficient.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
