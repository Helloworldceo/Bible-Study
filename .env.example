# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Required. A Neon Postgres connection string, used for user
# accounts, auth tokens, and multi-device sync data (see db.ts). Use the
# *pooled* connection string from your Neon project (Dashboard -> Connect,
# "Pooled connection") -- this app runs fine on a serverless/edge platform,
# which a direct (non-pooled) connection can't handle under concurrent load.
# Do NOT append `channel_binding=require`; some environments can't resolve
# it reliably. `sslmode=require` alone is sufficient.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# CRON_SECRET: Optional but recommended. Protects /api/discord/daily-post
# (the automatic daily Discord post, triggered by Vercel Cron -- see
# vercel.json) from being hit by anyone else and spamming your Discord
# channel on demand. Vercel automatically sends this as a Bearer token
# when it invokes the cron job, if the variable is set. Generate one with:
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
CRON_SECRET="MY_RANDOM_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Required for "Continue with Google" sign-in. Create an
# OAuth 2.0 Client ID (type "Web application") in Google Cloud Console ->
# APIs & Services -> Credentials, with your site's URL under "Authorized
# JavaScript origins" (no path). It's the same value on both lines below --
# the VITE_ prefixed one is what Vite exposes to the browser bundle (a
# Client ID is meant to be public, unlike an API key or client secret).
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
