# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Required. A Neon Postgres connection string, used for user
# accounts, auth tokens, and multi-device sync data (see db.ts). Use the
# *pooled* connection string from your Neon project (Dashboard -> Connect,
# "Pooled connection") -- this app runs fine on a serverless/edge platform,
# which a direct (non-pooled) connection can't handle under concurrent load.
# Do NOT append `channel_binding=require`; some environments can't resolve
# it reliably. `sslmode=require` alone is sufficient.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# CRON_SECRET: Optional but recommended. Protects the two Vercel Cron jobs
# (/api/discord/daily-post and /api/push/daily-reminder -- see vercel.json)
# from being hit by anyone else on demand. Vercel automatically sends this
# as a Bearer token when it invokes a cron job, if the variable is set.
# Generate one with:
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
CRON_SECRET="MY_RANDOM_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Required for "Continue with Google" sign-in. Create an
# OAuth 2.0 Client ID (type "Web application") in Google Cloud Console ->
# APIs & Services -> Credentials, with your site's URL under "Authorized
# JavaScript origins" (no path). It's the same value on both lines below --
# the VITE_ prefixed one is what Vite exposes to the browser bundle (a
# Client ID is meant to be public, unlike an API key or client secret).
GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="MY_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# VAPID_*: Required for the daily "keep your streak alive" push
# notification. This is a self-signed key pair Web Push uses to identify
# your server to browsers' push services -- unlike Google's Client ID,
# there's no third-party console step; generate your own pair with:
# `node -e "console.log(require('web-push').generateVAPIDKeys())"`
# VAPID_SUBJECT must be a mailto: link or https: URL a push service can
# reach you at if your server is misbehaving. The public key is meant to be
# public (same VITE_ exposure pattern as the Google Client ID above); never
# share the private key.
VAPID_PUBLIC_KEY="MY_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="MY_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:you@example.com"
VITE_VAPID_PUBLIC_KEY="MY_VAPID_PUBLIC_KEY"
